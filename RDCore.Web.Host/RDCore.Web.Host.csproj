<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyTitle>RDCore.Web Host</AssemblyTitle>
    <Description>The ASP.NET Core host of RDCore.Web.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.Web\RDCore.Web.csproj" />
  </ItemGroup>

  <!-- the build output holds wwwroot as a publish does, so that an application whose content root is its output folder serves it: the tests' does. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
